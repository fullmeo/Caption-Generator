# Production Environment Variables
# Copy this file to .env.production and fill in your values

# ============ API CONFIGURATION ============
# URL of your backend API
# For Netlify deployment, this should be your backend URL
VITE_API_URL=https://api.caption-generator.app

# ============ APP CONFIGURATION ============
# App name (used in PWA manifest)
VITE_APP_NAME=Caption Generator

# App version
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=production

# ============ ANALYTICS (Optional) ============
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# Plausible Analytics Domain
# VITE_PLAUSIBLE_DOMAIN=caption-generator.app

# ============ FEATURE FLAGS (Optional) ============
# Enable dark mode
# VITE_ENABLE_DARK_MODE=false

# Enable push notifications
# VITE_ENABLE_PUSH_NOTIFICATIONS=false

# Enable analytics
# VITE_ENABLE_ANALYTICS=true

# ============ NOTES ============
# - Variables MUST start with VITE_ to be accessible in the code
# - Never commit .env.production with real values to Git
# - Configure these in Netlify Site settings > Environment variables
# - Rebuild required after changing environment variables
